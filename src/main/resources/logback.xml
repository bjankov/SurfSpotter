<configuration>
    <appender name="CONSOLE"
              class="...ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level
                %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>
    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>