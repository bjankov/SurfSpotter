<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.controlsfx.control.*?>

<VBox prefHeight="600.0" prefWidth="1150.0" spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.surfspot.controller.surfspot.SurfSpotListController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Mjesta za surfanje" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Button mnemonicParsing="false" onAction="#handleToggleItinerary" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Plan putovanja" />

        <Button mnemonicParsing="false" onAction="#handleAdd" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Dodaj" />
        <Button mnemonicParsing="false" onAction="#handleEdit" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Uredi" />
        <Button mnemonicParsing="false" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Obriši" />
    </HBox>

    <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Pretraga i filteri:">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="spotSearchField" prefWidth="250.0" promptText="Upiši ime spota..." />
            <Button mnemonicParsing="false" onAction="#handleClearFilters" text="Očisti filtere" />
        </HBox>
        <FlowPane alignment="CENTER_LEFT" hgap="10.0" vgap="10.0">
            <CheckComboBox fx:id="difficultyComboBox" prefWidth="130.0" title="Težina" />
         <CheckComboBox fx:id="waveTypeComboBox" title="Tip vala" />

            <HBox alignment="CENTER_LEFT" spacing="5.0">
                <Label text="Prosječna visina vala (m):" textFill="#7f8c8d" />
                <TextField fx:id="minWaveHeightField" prefWidth="60.0" promptText="Min" />
                <Label text="-" textFill="#7f8c8d" />
                <TextField fx:id="maxWaveHeightField" prefWidth="60.0" promptText="Max" />
            </HBox>
         <CheckComboBox fx:id="seasonComboBox" title="Sezona" />
         <CheckComboBox fx:id="coastComboBox" title="Obala" />
         <CheckComboBox fx:id="countryComboBox" title="Država" />
        </FlowPane>
    </VBox>

    <SplitPane fx:id="mainSplitPane" dividerPositions="0.4, 0.75" VBox.vgrow="ALWAYS">

        <TableView fx:id="surfSpotTable" prefWidth="400.0">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Ime" />
                <TableColumn fx:id="locationColumn" prefWidth="150.0" text="Lokacija" />
                <TableColumn fx:id="difficultyColumn" prefWidth="100.0" text="Težina" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <VBox maxWidth="300.0" minWidth="300.0" spacing="10.0" style="-fx-background-color: #f8f9fa;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <Label text="Detalji mjesta za surfanje" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                <ImageView fx:id="spotImageView" fitHeight="150.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
            </HBox>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                </columnConstraints>

                <Label text="Obala i država:" GridPane.rowIndex="0">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <Label fx:id="locationLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Koordinate:" GridPane.rowIndex="1">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <Label fx:id="coordinatesLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Sezona:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <Label fx:id="seasonLabel" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Valovi:" GridPane.rowIndex="3">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <Label fx:id="waveDetailsLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Vjetar:" GridPane.rowIndex="4">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <Label fx:id="windDetailsLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <Label text="Instruktori:">
                <font><Font name="System Bold" size="12.0" /></font>
                <VBox.margin><Insets top="10.0" /></VBox.margin>
            </Label>
            <ListView fx:id="instructorListView" VBox.vgrow="ALWAYS" />
        </VBox>

        <VBox fx:id="itineraryPanel" minWidth="250.0" spacing="10.0" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <Label text="Moj Plan Putovanja" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label text="Prevuci spotove iz tablice ovdje" textFill="#7f8c8d" />

            <ListView fx:id="itineraryListView" style="-fx-background-color: white;" VBox.vgrow="ALWAYS" />

            <Button maxWidth="1.1797693134862315E308" mnemonicParsing="false" onAction="#handleExport" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;" text="Izvezi Plan Putovanja" />
        </VBox>

    </SplitPane>
</VBox>
