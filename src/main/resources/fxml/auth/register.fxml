<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.surfspot.controller.auth.RegisterController">
   <Label text="Create Account"/>

   <TextField fx:id="emailField" promptText="email (optional)"/>

   <TextField fx:id="usernameField" promptText="username"/>

   <PasswordField fx:id="passwordField" promptText="password"/>

   <PasswordField fx:id="repeatPasswordField" promptText="repeat password"/>

   <Button defaultButton="true" onAction="#handleRegister" text="REGISTER"/>

   <Label text="Already have an account?"/>

   <Hyperlink onAction="#handleLoginLink" text="Log in"/>
</VBox>
