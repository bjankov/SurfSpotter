<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.surfspot.controller.auth.RegisterController">
   <Label text="Kreiraj racun"/>

   <TextField fx:id="usernameField" promptText="korisnicko ime"/>

   <TextField fx:id="emailField" promptText="email (nije obavezan)"/>

   <PasswordField fx:id="passwordField" promptText="Lozinka"/>

   <PasswordField fx:id="repeatPasswordField" promptText="Ponovite lozinku"/>

   <Button defaultButton="true" onAction="#handleRegister" text="REGISTRIRAJ SE"/>

   <Label text="Vec imas korisnicki racun?"/>

   <Hyperlink onAction="#handleLoginLink" text="Prijavi se"/>
</VBox>
