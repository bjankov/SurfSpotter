<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="250.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.surfspot.controller.auth.LoginController">
   <Label text="Login to Surf Spotter"/>

   <TextField fx:id="usernameField" promptText="username or email"/>

   <PasswordField fx:id="passwordField" promptText="password"/>

   <Button defaultButton="true" onAction="#handleLogin" text="LOGIN"/>

   <Label text="Don't have an account?"/>

   <Hyperlink onAction="#handleRegisterLink" text="Create an account"/>
</VBox>
