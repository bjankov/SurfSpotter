<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.CheckComboBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.surfspot.controller.instructor.InstructorListController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Instruktori" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Button mnemonicParsing="false" onAction="#handleAdd" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Dodaj" />
        <Button mnemonicParsing="false" onAction="#handleEdit" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Uredi" />
        <Button mnemonicParsing="false" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Obriši" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Pretraga i filteri:"/>
        <TextField fx:id="instructorSearchField" prefWidth="225.0" promptText="Unesite ime ili prezime instruktora"/>
        <CheckComboBox fx:id="schoolComboBox" title="Škole"/>
        <Button mnemonicParsing="false" onAction="#handleClearFilters" text="Očisti filtere"/>
    </HBox>

    <TableView fx:id="instructorTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="firstNameColumn" prefWidth="200.0" text="Ime" />
            <TableColumn fx:id="lastNameColumn" prefWidth="250.0" text="Prezime" />
            <TableColumn fx:id="schoolColumn" prefWidth="250.0" text="Škola surfanja" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
